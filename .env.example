VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# The Gemini key is NOT a VITE_ variable any more (those ship to every
# browser). Set it as a Supabase Edge Function secret instead:
#   supabase secrets set GEMINI_API_KEY=... SITE_URL=https://<your-site> --project-ref <ref>
